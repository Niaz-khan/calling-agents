# Frontend build/environment reference.
#
# Vite reads variables prefixed with VITE_ from .env / .env.production at build
# time. Both are optional: leaving them empty makes the app same-origin with
# the backend (nginx proxies /auth, /agents, /public, ... to Django).

# Empty -> relative API calls to the current origin (recommended in prod).
VITE_API_BASE=

# Public widget.js base URL used in deployment snippets. Empty -> derives from
# the current window origin at runtime.
VITE_WIDGET_BASE_URL=