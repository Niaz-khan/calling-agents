# Base URL of the backend API.
# Leave empty in dev: Vite proxies /api... requests (see vite.config.js).
# Example: VITE_API_BASE=https://api.example.com
#VITE_API_BASE=

# Origin that serves the widget (widget.js + public endpoints).
# Used to build the install snippet on the Deployment page.
# Falls back to VITE_API_BASE, then to the dashboard's own origin.
# Example: VITE_WIDGET_BASE_URL=https://app.example.com
#VITE_WIDGET_BASE_URL=