# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Speech-to-Text
# "openai" provider is OpenAI-compatible; set STT_BASE_URL to point at
# Groq (https://api.groq.com/openai/v1) and STT_MODEL=whisper-large-v3-turbo.
# STT_API_KEY falls back to LLM_API_KEY when empty.
STT_PROVIDER=openai
STT_MODEL=whisper-1
STT_LANGUAGE=
STT_API_KEY=
STT_BASE_URL=

# Text-to-Speech
# "edge" is free and keyless (Microsoft neural voices). Default voice:
#   en-US-JennyNeural
# "openai" uses gpt-4o-mini-tts and needs TTS_API_KEY / TTS_BASE_URL.
TTS_PROVIDER=edge
TTS_MODEL=en-US-JennyNeural
TTS_VOICE=en-US-JennyNeural
TTS_FORMAT=mp3
TTS_API_KEY=
TTS_BASE_URL=

# Voice session
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_HEARTBEAT_SECONDS=20
VOICE_IDLE_TIMEOUT_SECONDS=300

# Real-time voice streaming (Twilio Media Streams websocket)
# Enables the low-latency websocket voice path on inbound Twilio calls. While
# disabled (default) the TwiML/Gather loop remains the live path. Live calls
# require a provisioned (non-trial) Twilio number.
VOICE_STREAMING_ENABLED=0
# RMS amplitude/intensity above which a 20ms frame counts as speech (0..32767).
VOICE_STREAM_SPEECH_THRESHOLD=1000
# Trailing silence before the current utterance is committed to speech-to-text.
VOICE_STREAM_END_SILENCE_SECONDS=0.6

# Streaming TTS caveat: the free "edge" provider emits MP3, and converting MP3
# to G.711 mu-law needs ffmpeg on the server. If ffmpeg is unavailable, either
# install it or switch to tts: TTS_PROVIDER=openai + TTS_FORMAT=pcm.

# Telephony
# After provisioning a Twilio number, point its voice settings at:
#   A call comes in      -> POST https://<PUBLIC_BASE_URL>/telephony/webhook/inbound
#   Status callback URL  -> POST https://<PUBLIC_BASE_URL>/telephony/webhook/status
# PUBLIC_BASE_URL must be HTTPS and reachable from the internet, and must match
# the host Twilio calls (signature verification uses the exact request URL).
# Using Telnyx? Set TELEPHONY_PROVIDER=telnyx and provide:
#   TELNYX_API_KEY        -> Mission Control > Account Settings > API Keys
#   TELNYX_PUBLIC_KEY     -> Account Settings > Keys & Credentials (webhook signing)
#   TELNYX_CONNECTION_ID  -> Mission Control > Connections (Voice API Application)
# Telnyx delivers JSON call events to the webhook URL configured on the
# Telnyx connection; webhooks are Ed25519-signed using TELNYX_PUBLIC_KEY.
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
PUBLIC_BASE_URL=http://localhost:8000

# Django application
# Production: set DJANGO_ENV=production, DJANGO_DEBUG=0 and a strong unique
# DJANGO_SECRET_KEY. DJANGO_ENV=production fails startup on insecure values.
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_INTERNAL_IPS=127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Production security
# Set DJANGO_BEHIND_PROXY=1 when running behind nginx so Django honours the
# X-Forwarded-Proto header (secure cookies / SSL redirect then work).
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_X_FRAME_OPTIONS=DENY

# Database
DATABASE_URL=postgresql://callagent:callagent@localhost:5432/callagent
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=1
DB_CONNECT_TIMEOUT=10

# Redis (optional in development; recommended in production)
# Powers the Channels layer + Django cache (DRF throttling) and Celery broker.
REDIS_URL=
# Celery runs on its own logical redis db when provided.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# Static / media
# DJANGO_MEDIA_ROOT=/var/www/ai_call_agent/media (override in production)
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# Embeddings / Knowledge Base
# EMBEDDING_PROVIDER=openai works with any OpenAI-compatible embeddings API
# (OpenAI, Jina AI, Mistral, ...). Example for Jina's free tier:
#   EMBEDDING_API_KEY=jina_...
#   EMBEDDING_BASE_URL=https://api.jina.ai/v1
#   EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
KNOWLEDGE_SEARCH_LIMIT=5
KNOWLEDGE_RELEVANCE_THRESHOLD=0.30
