# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_call_agent

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Speech-to-Text
STT_PROVIDER=openai
STT_MODEL=whisper-1
STT_LANGUAGE=

# Text-to-Speech
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_FORMAT=wav

# Voice session
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_HEARTBEAT_SECONDS=20
VOICE_IDLE_TIMEOUT_SECONDS=300
