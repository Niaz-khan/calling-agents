# Production environment for docker compose -f docker-compose.production.yml.
# Copy to backend/.env.production, replace every placeholder, and never commit
# the real file. See backend/docs/production-deployment.md.

# --- Domain / infrastructure -------------------------------------------------
DOMAIN=yourdomain.com
# Matches the caller-facing, internet-reachable URL (must be HTTPS).
PUBLIC_BASE_URL=https://yourdomain.com

# --- Django ------------------------------------------------------------------
DJANGO_ENV=production
DJANGO_DEBUG=0
# Use: openssl rand -hex 48
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=yourdomain.com
# Use: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
DJANGO_BEHIND_PROXY=1
# nginx already redirects :80 -> :443; keep the Django-level redirect off to
# avoid redirect loops behind the proxy.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Host is the compose service name (`postgres`), reachable from containers.
POSTGRES_DB=callagent
POSTGRES_USER=callagent
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql://callagent:replace-with-a-strong-db-password@postgres:5432/callagent
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=1
DB_CONNECT_TIMEOUT=10

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- JWT --------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-another-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI layer ---------------------------------------------------------------
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
STT_PROVIDER=openai
STT_MODEL=whisper-1
STT_LANGUAGE=
STT_API_KEY=
STT_BASE_URL=
TTS_PROVIDER=edge
TTS_MODEL=en-US-JennyNeural
TTS_VOICE=en-US-JennyNeural
TTS_FORMAT=mp3
TTS_API_KEY=
TTS_BASE_URL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
KNOWLEDGE_SEARCH_LIMIT=5
KNOWLEDGE_RELEVANCE_THRESHOLD=0.30

# --- Voice streaming --------------------------------------------------------
VOICE_STREAMING_ENABLED=0
VOICE_STREAM_SPEECH_THRESHOLD=1000
VOICE_STREAM_END_SILENCE_SECONDS=0.6
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_HEARTBEAT_SECONDS=20
VOICE_IDLE_TIMEOUT_SECONDS=300

# --- Telephony --------------------------------------------------------------
# The public webhook URL base is PUBLIC_BASE_URL above. Twilio/Telnyx webhook
# signature validation stays mandatory and uses these credentials:
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=